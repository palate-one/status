---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Palate 서비스 상태",
  description = "Palate Web과 API의 현재 상태와 최근 관측을 확인해요.",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <slot />
  </body>
</html>
