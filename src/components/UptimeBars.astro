---
import type { DailyUptimeViewModel } from "../status/view-model";

interface Props {
  componentLabel: string;
  days: readonly DailyUptimeViewModel[];
}

const { componentLabel, days } = Astro.props;
const placeholderCount = 30;
---

<section
  class="uptime-block"
  data-uptime-component={componentLabel.toLowerCase()}
  aria-labelledby={`${componentLabel.toLowerCase()}-uptime-heading`}
>
  <div class="uptime-heading">
    <h4 id={`${componentLabel.toLowerCase()}-uptime-heading`}>{componentLabel} 최근 30일</h4>
    <p>UTC 기준</p>
  </div>
  <ol class="uptime-rail" data-uptime-list>
    {days.length === 0 ? (
      <>
        {Array.from({ length: placeholderCount }).map(() => (
          <li class="uptime-day is-placeholder" data-uptime-placeholder aria-hidden="true"></li>
        ))}
        <li class="uptime-empty-label sr-only">측정 데이터 없음</li>
      </>
    ) : (
      days.map((day) => (
        <li
          class:list={[
            "uptime-day",
            day.uptimePercent === null ? "is-empty" : day.downSamples > 0 ? "has-down" : "is-up",
          ]}
          data-uptime-day={day.day}
          aria-label={day.ariaLabel}
          title={day.ariaLabel}
        >
          <span class="day-mark" aria-hidden="true">
            {day.uptimePercent === null ? "—" : day.downSamples > 0 ? "!" : "✓"}
          </span>
        </li>
      ))
    )}
  </ol>
  <p class="uptime-note">각 칸에 마우스를 올리면 날짜와 관측 범위를 확인할 수 있어요.</p>
</section>
