---
import { type CollectionEntry } from "astro:content";

import { sortIncidents } from "../status/view-model";
import IncidentEntry from "./IncidentEntry.astro";

interface Props {
  entries: readonly CollectionEntry<"incidents">[];
  mode: "active";
}

const { entries } = Astro.props;
const visibleEntries = sortIncidents(entries).filter(({ data }) => data.status !== "resolved");
---

<section class="status-section" aria-labelledby="active-incidents-heading">
  <div class="section-heading">
    <p class="eyebrow">운영 기록</p>
    <h2 id="active-incidents-heading">진행 중인 장애</h2>
  </div>
  {visibleEntries.length === 0 ? (
    <p class="empty-state">현재 진행 중인 장애가 없어요.</p>
  ) : (
    <div class="timeline-list">
      {visibleEntries.map((entry) => <IncidentEntry entry={entry} headingLevel="h3" />)}
    </div>
  )}
</section>
