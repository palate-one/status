---
import { type CollectionEntry } from "astro:content";

import { sortMaintenance } from "../status/view-model";
import MaintenanceEntry from "./MaintenanceEntry.astro";

interface Props {
  entries: readonly CollectionEntry<"maintenance">[];
  mode: "upcoming";
}

const { entries } = Astro.props;
const visibleEntries = sortMaintenance(entries).filter(({ data }) =>
  data.status === "scheduled" || data.status === "in_progress",
);
---

<section class="status-section" aria-labelledby="maintenance-heading">
  <div class="section-heading">
    <p class="eyebrow">예정된 변경</p>
    <h2 id="maintenance-heading">점검 일정</h2>
  </div>
  {visibleEntries.length === 0 ? (
    <p class="empty-state">예정된 점검이 없어요.</p>
  ) : (
    <div class="timeline-list">
      {visibleEntries.map((entry) => <MaintenanceEntry entry={entry} headingLevel="h3" />)}
    </div>
  )}
</section>
