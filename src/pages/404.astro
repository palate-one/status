---
import StatusLayout from "../layouts/StatusLayout.astro";
---

<StatusLayout title="페이지를 찾을 수 없어요 · Palate 상태">
  <main id="main-content" class="status-page error-page">
    <div class="status-content">
      <p class="eyebrow">404</p>
      <h1>페이지를 찾을 수 없어요.</h1>
      <p>요청한 운영 기록이 없거나 주소가 바뀌었어요.</p>
      <a class="text-link" href="/">상태 페이지로 돌아가기</a>
    </div>
  </main>
</StatusLayout>
