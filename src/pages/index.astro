---
import { getCollection } from "astro:content";

import ComponentStatus from "../components/ComponentStatus.astro";
import HistoryTimeline from "../components/HistoryTimeline.astro";
import IncidentList from "../components/IncidentList.astro";
import MaintenanceList from "../components/MaintenanceList.astro";
import OverallStatus from "../components/OverallStatus.astro";
import StatusLayout from "../layouts/StatusLayout.astro";
import type { ComponentStatusViewModel } from "../status/view-model";

const incidents = await getCollection("incidents");
const maintenance = await getCollection("maintenance");

const initialComponents: ComponentStatusViewModel[] = [
  {
    id: "web",
    label: "Web",
    status: "unknown",
    statusLabel: "상태 확인 불가",
    uptimeLabel: "측정 데이터 없음",
    coverageLabel: "측정 데이터 없음",
    lastCheckedLabel: "상태 확인 중",
    days: [],
  },
  {
    id: "api",
    label: "API",
    status: "unknown",
    statusLabel: "상태 확인 불가",
    uptimeLabel: "측정 데이터 없음",
    coverageLabel: "측정 데이터 없음",
    lastCheckedLabel: "상태 확인 중",
    days: [],
  },
];
---

<StatusLayout>
  <main id="main-content" class="status-page" data-status-page aria-busy="true">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/" aria-label="Palate 상태 페이지 홈">
          <img class="brand-logo" src="/palate-logo.svg" alt="" width="48" height="48" />
          <span>status</span>
        </a>
        <p>공개 운영 기록</p>
      </div>
    </header>

    <div class="status-content">
      <OverallStatus
        status="verification_unavailable"
        label="상태 확인 중"
        lastCheckedLabel="잠시만 기다려 주세요"
      />

      <section class="status-section" aria-labelledby="components-heading">
        <div class="section-heading">
          <p class="eyebrow">서비스 구성 요소</p>
          <h2 id="components-heading">서비스 상태와 최근 30일 가동률</h2>
        </div>
        <div class="component-grid" data-component-list>
          {initialComponents.map((component) => <ComponentStatus component={component} loading />)}
        </div>
      </section>

      <IncidentList entries={incidents} mode="active" />
      <MaintenanceList entries={maintenance} mode="upcoming" />
      <HistoryTimeline incidents={incidents} maintenance={maintenance} />

      <footer class="site-footer">
        <p>이 페이지는 공개 Web 응답과 API readiness 관측만 보여줘요. 모든 사용자 흐름의 정상 동작을 뜻하지 않아요.</p>
      </footer>
    </div>
  </main>

  <script>
    import { hydrateStatus } from "../scripts/status-client";

    hydrateStatus();
  </script>
</StatusLayout>
