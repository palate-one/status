{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palate-status",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "routes": [
    {
      "pattern": "status.palate.one",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "palate-status",
      "database_id": "7c242db6-4020-46ec-9a5b-9f20ea65577c",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "STATUS_READ_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
